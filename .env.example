# Tongric Application Environment Configuration
# Copy to .env (loaded by both Next.js and Prisma CLI) for local development.
# Never commit real secrets.

NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tongric

# PostgreSQL connection string (Supabase Session Pooler / Neon — SSL required in cloud)
# Example: postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
DATABASE_URL=

# Cloudinary file storage (all 3 required when enabling Cloudinary;
# if omitted, local dev falls back to .tongric-local-storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
