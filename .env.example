# Tongric Application Environment Configuration
# Copy to .env (loaded by both Next.js and Prisma CLI) for local development.
# Never commit real secrets.

NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Tongric

# PostgreSQL connection string (Neon or Supabase — SSL required in cloud environments)
# Example: postgresql://USER:PASSWORD@HOST/tongric?sslmode=require
DATABASE_URL=
