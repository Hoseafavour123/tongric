generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Review workflow status for multilingual UI strings.
enum TranslationStatus {
  DRAFT
  REVIEWED
  VALIDATED
}

/// Primary account role within Tongric. ADMIN cannot self-register publicly.
enum UserRole {
  FARMER
  BUYER
  TRANSPORT_PROVIDER
  ADMIN
}

/// Account lifecycle state enforced during login and protected actions.
enum AccountStatus {
  ACTIVE
  SUSPENDED
  LOCKED
}

/// Versioned NDPA 2023 consent categories captured explicitly at registration or preference change.
enum ConsentType {
  TERMS_AND_PRIVACY
  OPTIONAL_UPDATES
  FINANCIAL_DATA_SHARING
}

/// Verification lifecycle states for market participants and uploaded credentials.
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

/// Categorization of produce buyers operating on the platform.
enum BuyerType {
  PROCESSOR
  WHOLESALER
  RETAILER
  RESTAURANT_HOTEL
  INSTITUTIONAL
}

/// Standardized vehicle categories for agricultural logistics coordination.
enum VehicleType {
  MOTORCYCLE_TRICYCLE
  PICKUP
  VAN
  TRUCK
}

/// Pricing agreement models between buyers/farmers and transport providers.
enum PricingModel {
  FIXED_RATE_CARD
  QUOTE_ON_REQUEST
}

/// Permissible verification document categories for farmers, buyers, and transporters.
enum DocumentType {
  NATIONAL_ID
  VOTERS_CARD
  DRIVERS_LICENSE
  CAC_CERTIFICATE
  COOPERATIVE_LETTER
  COMMUNITY_ATTESTATION
}

/// Lifecycle state of a commercial produce listing.
enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD_OUT
  CANCELLED
}

/// Standardized quality grade for Benue agricultural produce.
enum ProduceGrade {
  GRADE_A
  GRADE_B
  GRADE_C
}

/// Harvest availability timeframe for produce listings.
enum AvailabilityStatus {
  AVAILABLE_NOW
  UPCOMING_HARVEST
}

/// Status lifecycle of a commercial purchase offer.
enum OfferStatus {
  PENDING
  COUNTERED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

/// Delivery and collection responsibility for produce offers.
enum FulfillmentMode {
  BUYER_ARRANGES_PICKUP
  FARMER_ARRANGES_DELIVERY
  TONGRIC_LOGISTICS_REQUEST
}

/// Lifecycle state of a confirmed commercial order.
enum OrderStatus {
  CONFIRMED
  TRANSPORT_REQUESTED
  TRANSPORT_ASSIGNED
  COLLECTED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

/// Categorization of in-app activity notifications and low-bandwidth SMS alerts.
enum NotificationCategory {
  OFFER_ACTIVITY
  ORDER_STATUS
  TRANSPORT_DISPATCH
  SYSTEM_ALERT
}

/// Permissible item types for farmer-to-farmer agricultural exchange.
enum ExchangeItemType {
  CROP
  SEED
  TOOL
  EQUIPMENT
}

/// Lifecycle state of a farmer barter exchange listing.
enum ExchangeListingStatus {
  OPEN
  AGREED
  COMPLETED
  CANCELLED
}

/// Lifecycle state of an exchange offer submitted by a peer farmer.
enum ExchangeOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// Lifecycle state of a confirmed barter agreement between two farmers.
enum ExchangeAgreementStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Processing lifecycle of a simple credit demonstration application.
enum LoanApplicationStatus {
  SUBMITTED
  UNDER_PARTNER_REVIEW
  ADDITIONAL_INFO_REQUESTED
  APPROVED
  DECLINED
}

/// Registered platform identity anchored to canonical Nigerian E.164 phone number.
model User {
  id                    String        @id @default(cuid())
  phoneNumber           String        @unique
  email                 String?       @unique
  fullName              String
  passwordHash          String
  role                  UserRole
  accountStatus         AccountStatus @default(ACTIVE)
  preferredLanguageCode String        @default("en")
  assistedByUserId      String?
  lastLoginAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  assistedBy    User?           @relation("AssistedOnboarding", fields: [assistedByUserId], references: [id], onDelete: SetNull)
  assistedUsers User[]          @relation("AssistedOnboarding")
  consents      ConsentRecord[]
  recoveryCodes RecoveryCode[]
  sessions         Session[]
  farmerProfile    FarmerProfile?
  buyerProfile     BuyerProfile?
  transportProfile TransportProfile?
  verificationDocs VerificationDocument[]
  listings         ProduceListing[]
  buyerOffers      CommercialOffer[]      @relation("BuyerOffers")
  farmerOffers     CommercialOffer[]      @relation("FarmerOffers")
  offerActions     CommercialOffer[]      @relation("OfferActions")
  offerMessages    OfferMessage[]
  farmerOrders     Order[]                @relation("FarmerOrders")
  buyerOrders      Order[]                @relation("BuyerOrders")
  transporterOrders Order[]               @relation("TransporterOrders")
  orderStatusEvents OrderStatusEvent[]
  transporterReviews CarrierReview[]      @relation("TransporterReviews")
  submittedReviews   CarrierReview[]      @relation("ReviewerReviews")
  notifications      Notification[]
  exchangeListings   ExchangeListing[]
  exchangeOffers     ExchangeOffer[]
  farmerAAgreements  ExchangeAgreement[]    @relation("FarmerAAgreements")
  farmerBAgreements  ExchangeAgreement[]    @relation("FarmerBAgreements")
  loanApplications   LoanApplication[]

  @@index([role, accountStatus])
  @@index([preferredLanguageCode])
  @@index([assistedByUserId])
  @@map("users")
}

/// Immutable timestamped record of user consent under NDPA 2023.
model ConsentRecord {
  id            String      @id @default(cuid())
  userId        String
  consentType   ConsentType
  policyVersion String
  granted       Boolean
  locale        String
  ipAddress     String?
  userAgent     String?
  grantedAt     DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanApplications LoanApplication[]

  @@index([userId, consentType])
  @@index([policyVersion])
  @@map("consent_records")
}

/// Hashed single-use account recovery codes for rural users without email access.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isUsed])
  @@map("recovery_codes")
}

/// Revocable authentication sessions anchored to an HTTP-only secure cookie.
model Session {
  id          String    @id @default(cuid())
  userId      String
  sessionHash String    @unique
  expiresAt   DateTime
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

/// Operational farm profile anchoring a farmer to Benue State LGA, community, and crops.
model FarmerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique @map("user_id")
  state              String             @default("Benue")
  lga                String
  community          String
  primaryCrops       String[]           @map("primary_crops")
  cooperativeName    String?            @map("cooperative_name")
  farmSizeHectares   Decimal?           @map("farm_size_hectares") @db.Decimal(8, 2)
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lga])
  @@index([verificationStatus])
  @@map("farmer_profiles")
}

/// Operational commercial profile anchoring a produce buyer to sourcing needs and location.
model BuyerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique @map("user_id")
  businessName       String             @map("business_name")
  buyerType          BuyerType          @map("buyer_type")
  state              String             @default("Benue")
  operatingLga       String             @map("operating_lga")
  primaryMarket      String?            @map("primary_market")
  cropsSourced       String[]           @map("crops_sourced")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([operatingLga])
  @@index([buyerType])
  @@index([verificationStatus])
  @@map("buyer_profiles")
}

/// Operational fleet profile anchoring a transport provider to carrying capacity and service routes.
model TransportProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique @map("user_id")
  operatorName       String             @map("operator_name")
  vehicleTypes       VehicleType[]      @map("vehicle_types")
  maxCapacityKg      Int                @map("max_capacity_kg")
  operatingLgas      String[]           @map("operating_lgas")
  isAvailable        Boolean            @default(true) @map("is_available")
  pricingModel       PricingModel       @default(QUOTE_ON_REQUEST) @map("pricing_model")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isAvailable])
  @@index([verificationStatus])
  @@map("transport_profiles")
}

/// Encrypted/private verification credentials submitted for identity and market compliance review.
model VerificationDocument {
  id               String             @id @default(cuid())
  userId           String             @map("user_id")
  documentType     DocumentType       @map("document_type")
  documentNumber   String?            @map("document_number")
  fileStoragePath  String             @map("file_storage_path")
  fileMimeType     String             @map("file_mime_type")
  fileSizeBytes    Int                @map("file_size_bytes")
  notes            String?            @map("notes")
  status           VerificationStatus @default(PENDING) @map("status")
  reviewedByUserId String?            @map("reviewed_by_user_id")
  reviewedAt       DateTime?          @map("reviewed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([reviewedAt])
  @@map("verification_documents")
}

/// Commercial produce batch offered for sale by a registered farmer or producer.
model ProduceListing {
  id                 String             @id @default(cuid())
  farmerId           String             @map("farmer_id")
  title              String
  cropCode           String             @map("crop_code")
  cropCategory       String             @map("crop_category")
  grade              ProduceGrade       @default(GRADE_B)
  quantity           Int
  unitCode           String             @map("unit_code")
  estimatedWeightKg  Float              @map("estimated_weight_kg")
  pricePerUnit       Decimal            @db.Decimal(12, 2) @map("price_per_unit")
  currency           String             @default("NGN")
  minOrderQuantity   Int                @default(1) @map("min_order_quantity")
  isNegotiable       Boolean            @default(true) @map("is_negotiable")
  availabilityStatus AvailabilityStatus @default(AVAILABLE_NOW) @map("availability_status")
  harvestDate        DateTime?          @map("harvest_date")
  state              String             @default("Benue")
  lga                String
  community          String
  description        String?
  status             ListingStatus      @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  farmer User              @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  photos ListingPhoto[]
  offers CommercialOffer[]
  orders Order[]

  @@index([farmerId])
  @@index([cropCode])
  @@index([lga])
  @@index([status])
  @@index([createdAt])
  @@map("produce_listings")
}

/// Public product media demonstrating quality and batch condition of produce.
model ListingPhoto {
  id              String   @id @default(cuid())
  listingId       String   @map("listing_id")
  fileStoragePath String   @map("file_storage_path")
  publicUrl       String   @map("public_url")
  mimeType        String   @map("mime_type")
  sizeBytes       Int      @map("size_bytes")
  isPrimary       Boolean  @default(false) @map("is_primary")
  createdAt       DateTime @default(now()) @map("created_at")

  listing ProduceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_photos")
}

/// Commercial purchase offer initiated on a produce listing.
model CommercialOffer {
  id                     String          @id @default(cuid())
  offerCode              String          @unique @map("offer_code")
  listingId              String          @map("listing_id")
  buyerId                String          @map("buyer_id")
  farmerId               String          @map("farmer_id")
  status                 OfferStatus     @default(PENDING)
  quantity               Int
  unitCode               String          @map("unit_code")
  unitPrice              Decimal         @map("unit_price") @db.Decimal(12, 2)
  currency               String          @default("NGN")
  totalAmount            Decimal         @map("total_amount") @db.Decimal(14, 2)
  fulfillmentMode        FulfillmentMode @map("fulfillment_mode")
  destinationLocation    String?         @map("destination_location")
  proposedCollectionDate DateTime?       @map("proposed_collection_date")
  expiresAt              DateTime        @map("expires_at")
  counterRoundCount      Int             @default(0) @map("counter_round_count")
  lastActionById         String          @map("last_action_by_id")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  listing      ProduceListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer        User           @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Restrict)
  farmer       User           @relation("FarmerOffers", fields: [farmerId], references: [id], onDelete: Restrict)
  lastActionBy User           @relation("OfferActions", fields: [lastActionById], references: [id], onDelete: Restrict)
  messages     OfferMessage[]
  order        Order?

  @@index([listingId, status])
  @@index([buyerId, status])
  @@index([farmerId, status])
  @@index([expiresAt])
  @@map("commercial_offers")
}

/// Immutable negotiation message and revision in an offer thread.
model OfferMessage {
  id                String   @id @default(cuid())
  offerId           String   @map("offer_id")
  senderId          String   @map("sender_id")
  action            String   // INITIATE, COUNTER, ACCEPT, DECLINE, WITHDRAW
  proposedQuantity  Int?     @map("proposed_quantity")
  proposedUnitPrice Decimal? @map("proposed_unit_price") @db.Decimal(12, 2)
  note              String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  offer  CommercialOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sender User            @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([offerId, createdAt])
  @@map("offer_messages")
}

/// Binding commercial order resulting from an accepted purchase offer.
model Order {
  id                     String          @id @default(cuid())
  orderCode              String          @unique @map("order_code")
  offerId                String          @unique @map("offer_id")
  listingId              String          @map("listing_id")
  farmerId               String          @map("farmer_id")
  buyerId                String          @map("buyer_id")
  transporterId          String?         @map("transporter_id")
  cropCode               String          @map("crop_code")
  quantity               Int
  unitCode               String          @map("unit_code")
  estimatedWeightKg      Float           @map("estimated_weight_kg")
  unitPrice              Decimal         @map("unit_price") @db.Decimal(12, 2)
  currency               String          @default("NGN")
  totalAmount            Decimal         @map("total_amount") @db.Decimal(14, 2)
  fulfillmentMode        FulfillmentMode @map("fulfillment_mode")
  destinationLocation    String?         @map("destination_location")
  proposedCollectionDate DateTime?       @map("proposed_collection_date")
  corridorRoute          String?         @map("corridor_route")
  estimatedFreightFee    Decimal?        @map("estimated_freight_fee") @db.Decimal(12, 2)
  waybillNumber          String?         @unique @map("waybill_number")
  pickupPin              String?         @map("pickup_pin")
  deliveryPin            String?         @map("delivery_pin")
  pickupVerifiedAt       DateTime?       @map("pickup_verified_at")
  deliveryVerifiedAt     DateTime?       @map("delivery_verified_at")
  status                 OrderStatus     @default(CONFIRMED)
  paymentArrangementNote String?         @map("payment_arrangement_note")
  cancellationReason     String?         @map("cancellation_reason")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  offer        CommercialOffer    @relation(fields: [offerId], references: [id], onDelete: Restrict)
  listing      ProduceListing     @relation(fields: [listingId], references: [id], onDelete: Restrict)
  farmer       User               @relation("FarmerOrders", fields: [farmerId], references: [id], onDelete: Restrict)
  buyer        User               @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  transporter  User?              @relation("TransporterOrders", fields: [transporterId], references: [id], onDelete: SetNull)
  statusEvents OrderStatusEvent[]
  carrierReviews CarrierReview[]

  @@index([farmerId, status])
  @@index([buyerId, status])
  @@index([transporterId, status])
  @@index([listingId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

/// Post-delivery carrier review & 5-star performance rating.
model CarrierReview {
  id                 String   @id @default(cuid())
  orderId            String   @map("order_id")
  transporterId      String   @map("transporter_id")
  reviewerId         String   @map("reviewer_id")
  rating             Int      // 1 to 5 stars
  timelinessScore    Int      @default(5) @map("timeliness_score") // 1 to 5 stars
  cargoCareScore     Int      @default(5) @map("cargo_care_score") // 1 to 5 stars
  communicationScore Int      @default(5) @map("communication_score") // 1 to 5 stars
  comment            String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transporter User  @relation("TransporterReviews", fields: [transporterId], references: [id], onDelete: Cascade)
  reviewer    User  @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([orderId, reviewerId])
  @@index([transporterId, rating])
  @@index([reviewerId])
  @@map("carrier_reviews")
}

/// Immutable audit record of state transitions in an order's lifecycle.
model OrderStatusEvent {
  id          String       @id @default(cuid())
  orderId     String       @map("order_id")
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById String       @map("changed_by_id")
  note        String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User  @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

/// Append-only record of security-sensitive, verification, and governance events.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// In-app activity alert and low-bandwidth notification for market participants.
model Notification {
  id         String               @id @default(cuid())
  userId     String               @map("user_id")
  title      String
  body       String               @db.Text
  category   NotificationCategory @default(SYSTEM_ALERT)
  entityType String?              @map("entity_type")
  entityId   String?              @map("entity_id")
  actionUrl  String?              @map("action_url")
  isRead     Boolean              @default(false) @map("is_read")
  readAt     DateTime?            @map("read_at")
  createdAt  DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Farmer barter listing for agricultural commodities, seeds, or tools.
model ExchangeListing {
  id                 String                @id @default(cuid())
  ownerFarmerId      String                @map("owner_farmer_id")
  offeredItemType    ExchangeItemType      @default(CROP) @map("offered_item_type")
  offeredCropId      String?               @map("offered_crop_id")
  offeredTitle       String                @map("offered_title")
  offeredDescription String                @db.Text @map("offered_description")
  offeredQty         Float                 @map("offered_qty")
  offeredUnit        String                @map("offered_unit")
  desiredDescription String                @db.Text @map("desired_description")
  desiredQty         Float?                @map("desired_qty")
  desiredUnit        String?               @map("desired_unit")
  locationLga        String                @map("location_lga")
  status             ExchangeListingStatus @default(OPEN)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  ownerFarmer User                @relation(fields: [ownerFarmerId], references: [id], onDelete: Cascade)
  offers      ExchangeOffer[]
  agreements  ExchangeAgreement[]

  @@index([ownerFarmerId, status])
  @@index([status, locationLga])
  @@map("exchange_listings")
}

/// Farmer barter offer proposal submitted against an active exchange listing.
model ExchangeOffer {
  id                     String              @id @default(cuid())
  listingId              String              @map("listing_id")
  proposerFarmerId       String              @map("proposer_farmer_id")
  offeredItemDescription String              @db.Text @map("offered_item_description")
  offeredQty             Float               @map("offered_qty")
  offeredUnit            String              @map("offered_unit")
  message                String?             @db.Text
  status                 ExchangeOfferStatus @default(PENDING)
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  listing        ExchangeListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  proposerFarmer User                @relation(fields: [proposerFarmerId], references: [id], onDelete: Cascade)
  agreements     ExchangeAgreement[]

  @@index([listingId, status])
  @@index([proposerFarmerId, status])
  @@map("exchange_offers")
}

/// Confirmed barter exchange agreement between two verified farming parties.
model ExchangeAgreement {
  id                  String                  @id @default(cuid())
  listingId           String                  @map("listing_id")
  offerId             String                  @map("offer_id")
  farmerAId           String                  @map("farmer_a_id")
  farmerBId           String                  @map("farmer_b_id")
  termsSummary        String                  @db.Text @map("terms_summary")
  farmerAConfirmedAt  DateTime?               @map("farmer_a_confirmed_at")
  farmerBConfirmedAt  DateTime?               @map("farmer_b_confirmed_at")
  status              ExchangeAgreementStatus @default(ACTIVE)
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  listing ExchangeListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  offer   ExchangeOffer   @relation(fields: [offerId], references: [id], onDelete: Restrict)
  farmerA User            @relation("FarmerAAgreements", fields: [farmerAId], references: [id], onDelete: Restrict)
  farmerB User            @relation("FarmerBAgreements", fields: [farmerBId], references: [id], onDelete: Restrict)

  @@index([farmerAId])
  @@index([farmerBId])
  @@index([status])
  @@map("exchange_agreements")
}

/// Cooperative or development partner financing product shown in the pilot directory.
model FinancingProduct {
  id                  String            @id @default(cuid())
  partnerName         String            @map("partner_name")
  title               String
  description         String            @db.Text
  minAmountNgn        Int               @map("min_amount_ngn")
  maxAmountNgn        Int               @map("max_amount_ngn")
  interestRateSummary String            @map("interest_rate_summary")
  repaymentTerms      String            @map("repayment_terms")
  eligibilityText     String            @db.Text @map("eligibility_text")
  requiredDocuments   Json              @map("required_documents")
  isDemoProduct       Boolean           @default(true) @map("is_demo_product")
  isActive            Boolean           @default(true) @map("is_active")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  applications LoanApplication[]

  @@index([isActive])
  @@map("financing_products")
}

/// Consented credit demonstration application referencing verified Tongric commercial history.
model LoanApplication {
  id                             String                @id @default(cuid())
  referenceCode                  String                @unique @map("reference_code")
  farmerId                       String                @map("farmer_id")
  productId                      String                @map("product_id")
  requestedAmountNgn             Int                   @map("requested_amount_ngn")
  purpose                        String                @db.Text
  consentRecordId                String                @map("consent_record_id")
  transactionSummarySnapshotJson Json                  @map("transaction_summary_snapshot_json")
  documentKeys                   Json                  @map("document_keys")
  status                         LoanApplicationStatus @default(SUBMITTED)
  partnerNote                    String?               @db.Text @map("partner_note")
  createdAt                      DateTime              @default(now()) @map("created_at")
  updatedAt                      DateTime              @updatedAt @map("updated_at")

  farmer        User             @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  product       FinancingProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  consentRecord ConsentRecord    @relation(fields: [consentRecordId], references: [id], onDelete: Restrict)

  @@index([farmerId, status])
  @@index([productId, status])
  @@index([referenceCode])
  @@map("loan_applications")
}

/// Supported platform languages configured for pilot and expansion regions.
model Language {
  code            String             @id
  name            String
  nativeName      String
  isActive        Boolean            @default(true)
  isDefault       Boolean            @default(false)
  isPilotPriority Boolean            @default(false)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  entries         TranslationEntry[]

  @@index([isActive, sortOrder])
  @@map("languages")
}

/// Authoritative English source keys and translator context metadata.
model TranslationKey {
  id          String             @id @default(cuid())
  namespace   String
  key         String             @unique
  description String?
  defaultText String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  entries     TranslationEntry[]

  @@index([namespace])
  @@map("translation_keys")
}

/// Per-language translation entries gated by native-speaker validation status.
model TranslationEntry {
  id               String            @id @default(cuid())
  translationKeyId String
  languageCode     String
  text             String
  status           TranslationStatus @default(DRAFT)
  reviewedByName   String?
  reviewedAt       DateTime?
  updatedAt        DateTime          @updatedAt

  translationKey TranslationKey @relation(fields: [translationKeyId], references: [id], onDelete: Cascade)
  language       Language       @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@unique([translationKeyId, languageCode])
  @@index([languageCode, status])
  @@map("translation_entries")
}
